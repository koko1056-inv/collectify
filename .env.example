# iOS の課金（RevenueCat）
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxx

# 「URLをコピー」・SNSシェアで配る正規URL。
# 未設定なら既定で https://collectify.jp を使う（通常はこれで十分）。
# VITE_APP_URL は後方互換のために残しているので、新しく設定する場合は VITE_SITE_URL を使うこと。
# VITE_SITE_URL=https://collectify.jp

# LINE通知・LINEログイン・Appleサインイン（すべて未設定ならOFF＝今までと完全に同じ動作）
# 詳しい設定手順は docs/line-and-social-login-setup.md を参照。値はここに書かない。
#
# LINE公式アカウントのベーシックID（例 @xxxx）。未設定なら「友だち追加」の案内は出ない。
# VITE_LINE_OA_BASIC_ID=
#
# ログイン画面に「LINEでログイン」ボタンを出す（true/未設定）。
# VITE_ENABLE_LINE_LOGIN=
#
# Supabaseに設定したLINE用カスタムOAuthプロバイダの識別子（既定 custom:line）。
# VITE_LINE_AUTH_PROVIDER=
#
# ログイン画面に「Appleでサインイン」ボタンを出す（true/未設定）。
# VITE_ENABLE_APPLE_LOGIN=
